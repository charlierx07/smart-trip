# =============================================================
#  Smart Trip — Environment Variables Template
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env or .env.local to version control!
# =============================================================

# ── Firebase Configuration ────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# ── API Settings (optional overrides) ────────────────────────
# Default radius for nearby places in metres (default: 15000)
REACT_APP_SEARCH_RADIUS=15000

# Overpass API endpoint (default: https://overpass-api.de/api/interpreter)
# REACT_APP_OVERPASS_API=https://overpass-api.de/api/interpreter
