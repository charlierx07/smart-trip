# =============================================================
#  Smart Trip — Monorepo / Multi-Tier .gitignore
# =============================================================

# ── Dependencies (Root, Frontend, Backend) ───────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Production Builds ─────────────────────────────────────────
build/
**/build/
dist/
**/dist/

# ── Environment / Secrets (NEVER commit secrets) ──────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Firebase ──────────────────────────────────────────────────
firebase.json
.firebaserc
firebase-debug.log
firestore.rules
firestore.indexes.json
**/functions/node_modules/
**/functions/.env*

# ── API Keys / Certificates / Credentials ─────────────────────
*.key
*.pem
*.p12
*.pfx
secrets.json
service-account*.json
*-credentials.json
google-services.json
GoogleService-Info.plist

# ── Logs & Debugging ──────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log
logs/
**/logs/

# ── Testing & Coverage ────────────────────────────────────────
coverage/
**/coverage/
*.lcov
.nyc_output

# ── OS Generated Files ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editor / IDE Artifacts ────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ── Misc / Temporary ──────────────────────────────────────────
.blackboxrules
.cache
**/cache/
.parcel-cache
*.tgz
*.zip
